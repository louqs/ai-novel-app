# =============================================================================
# AI Novel App — 环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM 降级: Ollama (本地) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# --- Neo4j 知识图谱 ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- ChromaDB 向量存储 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- 外部 AI 检测 API (可选) ---
# GPTZERO_API_KEY=
# ORIGINALITY_API_KEY=

# --- 应用配置 ---
NOVEL_ENV=development          # development | production
NOVEL_LOG_LEVEL=DEBUG          # DEBUG | INFO | WARNING | ERROR
NOVEL_DATA_DIR=./novel_output  # 小说产出目录
NOVEL_CONFIG_DIR=./config       # 配置目录
